{
  "schema_version": 1,
  "task": {
    "type": "classification"
  },
  "runtime": {
    "precision": "bf16",
    "cpu_threads": 2
  },
  "model": {
    "source": "local",
    "path": "/data/HF_MODELS/gpt2-xl",
    "head_policy": "global_trainable",
    "adapter": {
      "target_modules": [
        "c_attn"
      ],
      "rank": 4,
      "alpha": 8
    }
  },
  "data": {
    "source": "local",
    "path": "/data/HF_MODELS/data/ag_news",
    "text_fields": [
      "text"
    ],
    "label_field": "label",
    "train_split": "train",
    "eval_split": "test",
    "seq_len": 32,
    "max_train_samples": 64,
    "max_eval_samples": 32
  },
  "execution": {
    "backend": "local",
    "devices": [
      "cuda:0",
      "cuda:1",
      "cuda:2",
      "cuda:3"
    ],
    "placement": "balanced_count"
  },
  "evaluation": {
    "mode": "async",
    "devices": [
      "cuda:2",
      "cuda:3"
    ],
    "trigger": {
      "unit": "step",
      "every": 2
    },
    "at_end": true,
    "batch_size": 1,
    "pending_policy": "latest",
    "save_best": true,
    "metric": "loss",
    "direction": "min"
  },
  "output": {
    "root": "../runs",
    "checkpoint_every": 1,
    "trace_dispatch": true
  },
  "experiment": {
    "name": "agnews-gpt2-central",
    "seed": 42,
    "mode": "centralized"
  },
  "training": {
    "batch_size": 8,
    "micro_batch_size": 1,
    "budget": {
      "unit": "steps",
      "value": 4
    },
    "optimizer": {
      "name": "adamw",
      "lr": 0.0002
    },
    "max_grad_norm": 1,
    "scheduler": {
      "name": "constant",
      "warmup_steps": 0
    }
  },
  "timing": {
    "mode": "off"
  }
}
